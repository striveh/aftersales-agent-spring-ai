# OpenAI-compatible chat endpoint. Spring AI appends /v1/chat/completions.
# DeepSeek:
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# 通义千问（DashScope 兼容模式）示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OPENAI_MODEL=qwen-plus

# OpenAI 示例：
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini

# Set to true on the eval command to also run the LLM judge.
# EVAL_JUDGE=false
